# Set these to your deployed backend when building for production.
VITE_API_URL=https://your-backend.example.com/api
VITE_SOCKET_URL=https://your-backend.example.com

# Google OAuth client ID is public in a frontend bundle, but restrict its origins
# in Google Cloud Console. Never put a client secret in a VITE_ variable.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
