# Copy this file to .env and replace placeholders with your own values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>
PORT=5001
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Gmail SMTP for signup OTP and password-reset emails (works locally & on paid hosts).
# Note: Render Free blocks SMTP ports (465/587). For Render Free, use Brevo or Resend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=ChatKaro <your-gmail-address@gmail.com>

# OPTION A: Google Gmail API (Recommended for Render Free - Port 443 HTTPS):
# Sends emails directly from your real Gmail without getting blocked by Render's firewall.
# Run 'npm run get:gmail-token' in backend to generate GMAIL_REFRESH_TOKEN.
# GMAIL_USER=your-gmail-address@gmail.com
# GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-google-client-secret
# GMAIL_REFRESH_TOKEN=your-google-refresh-token

# OPTION B: Alternative HTTPS Email APIs (Port 443):
# BREVO_API_KEY=xkeysib-...
# RESEND_API_KEY=re_...

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
