# Copy this file to .env and replace placeholders with your own values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>
PORT=5001
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Google Gmail API (HTTPS Port 443 - works everywhere, including Render Free):
# Generates permanent refresh token via: npm run get:gmail-token
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REFRESH_TOKEN=your-google-refresh-token

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
