# Copy this file to .env and replace placeholders with your own values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>
PORT=5001
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Google Sign-In: must match frontend VITE_GOOGLE_CLIENT_ID exactly.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Gmail API email delivery (HTTPS; works on Render Free). Requires OAuth consent
# and a refresh token with https://www.googleapis.com/auth/gmail.send scope.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-refresh-token

# Frontend build-time variables (set in Render before building frontend):
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# VITE_API_URL=/api
