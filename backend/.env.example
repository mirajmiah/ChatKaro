# Copy this file to .env and replace placeholders with your own values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>
PORT=5001
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Gmail SMTP for signup OTP and password-reset emails (works locally & on paid hosts).
# Note: Render Free blocks SMTP ports (465/587). For Render Free, use Brevo or Resend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=ChatKaro <your-gmail-address@gmail.com>

# Recommended for Render Free (HTTPS Port 443, never blocked):
# Get a free Brevo API key at https://brevo.com (300 free emails/day)
# BREVO_API_KEY=xkeysib-...
# Or Resend API key at https://resend.com
# RESEND_API_KEY=re_...

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
